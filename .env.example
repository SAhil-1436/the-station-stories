# ==============================================================================
# THE STATION STORIES – Environment Variables Template
# Copy this file to .env and configure values for your environment.
# NEVER commit the real .env file with sensitive credentials to version control.
# ==============================================================================

# Database Configuration (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=the_station_stories
DB_USERNAME=root
DB_PASSWORD=your_secure_mysql_password_here

# Backend Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Security & JWT Configuration (Must be at least 256 bits / 64 characters in production)
JWT_SECRET=TheStationStoriesSecretKeyForJwtSigningMustBeVeryLong2026SecureKeyWithAtLeast64Chars!
JWT_EXPIRATION_MS=28800000

# CORS Whitelist Origin (Allowed frontend URL)
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:8080
VITE_RESTAURANT_NAME="The Station Stories"
VITE_DEFAULT_LANGUAGE=en
